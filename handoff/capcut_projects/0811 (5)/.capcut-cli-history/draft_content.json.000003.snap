lpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"우리가 더 이상 다른 사람 앞에서\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"d4d1f996-8153-49d2-b011-d1936032c949","type":"text","content":"{\"styles\":[{\"range\":[0,52],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"나쁜 생각을 하면 안 되는 세상이 올지도 모르죠\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"7420fc5d-86be-48c7-99a2-82837b3b85ae","type":"text","content":"{\"styles\":[{\"range\":[0,32],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"네 강우철 대표님, 감사합니다\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"4c7c7ccc-be78-4f01-99bd-23cc6229b695","type":"text","content":"{\"styles\":[{\"range\":[0,44],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"중요한 전화 같아서 나중에 다시 얘기하죠\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"eb0a5612-fb66-42dd-b1d3-36e1a51576a4","type":"text","content":"{\"styles\":[{\"range\":[0,26],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"아, 예, 기다리겠습니다\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"bf0290c2-7e3a-46c5-bdc8-64061892268c","type":"text","content":"{\"styles\":[{\"range\":[0,36],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"초대장 저 사람이 보낸 거 맞아?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"6bbc1111-337d-4c27-b164-d3c041f98790","type":"text","content":"{\"styles\":[{\"range\":[0,46],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"- 아, 뭐 해? 빨리 따라가 봐 - 응?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"0dd87908-d315-4747-906e-47f6d336617e","type":"text","content":"{\"styles\":[{\"range\":[0,32],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"아, 그냥 명함 한 장 주면서\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"5ae77b54-343e-4098-b713-c1faf3803115","type":"text","content":"{\"styles\":[{\"range\":[0,56],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"'제가 권세정입니다' 이 한마디만 하고 오면 된다고\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"49878da4-3f3e-4af4-83fb-2bf21dce7844","type":"text","content":"{\"styles\":[{\"range\":[0,38],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"제2의 인지 혁명이 일어나는 거라고\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"69248f76-c806-4f10-899f-6f15d6b0ae16","type":"text","content":"{\"styles\":[{\"range\":[0,12],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"그거 아니?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"c29b57bc-30f4-4daf-a77a-300152528a98","type":"text","content":"{\"styles\":[{\"range\":[0,2],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"넌\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"38512dfa-e057-4ec2-9800-a01017e7ba2f","type":"text","content":"{\"styles\":[{\"range\":[0,14],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"그냥 또라이야\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"69174456-b274-4198-aec4-c8357c3e66b4","type":"text","content":"{\"styles\":[{\"range\":[0,24],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"빨리 꺼져, 이 새끼야\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"0b46529c-e117-4b0c-94a1-c8224621f70a","type":"text","content":"{\"styles\":[{\"range\":[0,44],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"형은 지금 그 또라이의 지식을 훔친 거야\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"43a3cf62-16a2-4acb-9dc5-dbb4a151f1bb","type":"text","content":"{\"styles\":[{\"range\":[0,8],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"넌 아예\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"de9e7f55-d303-41aa-a646-7e08a9331e6b","type":"text","content":"{\"styles\":[{\"range\":[0,48],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"인간을 멸종시켜 버리고 싶은 거잖아, 그지?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"bd5e94b7-bb57-46e6-add2-f91025861570","type":"text","content":"{\"styles\":[{\"range\":[0,26],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"멸종이 아니야 형, 이거\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"fd0523ce-d4f3-4725-bae9-90ad3d2da023","type":"text","content":"{\"styles\":[{\"range\":[0,14],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"이거 탄생이야\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"b9a81896-7556-4588-bba6-536d21740849","type":"text","content":"{\"styles\":[{\"range\":[0,20],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"새로운 인류의 탄생\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"47ad310e-fdcb-4a24-8463-947ba6991ee1","type":"text","content":"{\"styles\":[{\"range\":[0,26],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"자, 형, 상상을 해 봐\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"c243a600-cef0-43aa-9c37-7e66a22b742a","type":"text","content":"{\"styles\":[{\"range\":[0,32],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"완전한 소통이 가능해지는 거야\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"31e26c44-c785-49a2-85e4-d19bc77d00c5","type":"text","content":"{\"styles\":[{\"range\":[0,58],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"그 얄팍한 개별성 때문에 발생하는 질투, 경쟁, 의심\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_