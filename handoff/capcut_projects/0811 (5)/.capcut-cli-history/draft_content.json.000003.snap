":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"cad08fb2-4c61-40b3-bed2-033ff86a47c4","type":"text","content":"{\"styles\":[{\"range\":[0,22],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"알파 팀 목표물 발견\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"0e9ede3e-247d-4510-b3f2-f4b5be74a58e","type":"text","content":"{\"styles\":[{\"range\":[0,36],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"알파 팀, 백신 확보, 백신 확보\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"aa237dae-aa99-4ce6-9f49-8f40d1e0ed5c","type":"text","content":"{\"styles\":[{\"range\":[0,32],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"목표물 확보했으면 빨리 철수해\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"7132ce0f-0a82-4256-99b6-9ccd78442aeb","type":"text","content":"{\"styles\":[{\"range\":[0,30],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"아휴, 쯧 뭐, 안타깝지마는\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"386c9ac8-24af-4724-8760-8392cae8ec44","type":"text","content":"{\"styles\":[{\"range\":[0,20],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"백신은 확보했으니까\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"85ae3586-5ff6-443a-b13c-0de9f92e11c7","type":"text","content":"{\"styles\":[{\"range\":[0,26],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"그, 그럼 저 사람은요?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"0efd2196-6b1d-4c1d-9a57-9b1196f91174","type":"text","content":"{\"styles\":[{\"range\":[0,30],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"그냥 저렇게 버려둘 거예요?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"ad958f49-ee58-4398-8992-fe7caec6177b","type":"text","content":"{\"style