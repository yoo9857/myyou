"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"아, 뭐야, 누나가?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"42ab23b2-a0a8-4232-a084-42db6739be7f","type":"text","content":"{\"styles\":[{\"range\":[0,10],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"아이...\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"b8b6c06a-c530-4df7-9858-b254e81905b2","type":"text","content":"{\"styles\":[{\"range\":[0,24],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"아, 여기에 남겠다고?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"ed49190d-7c29-4723-9b3c-e25b74cd595e","type":"text","content":"{\"styles\":[{\"range\":[0,28],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"가서 백신 데리고 다시 와\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"327e3d3c-613e-41ad-acaa-ecd4c1e31667","type":"text","conten