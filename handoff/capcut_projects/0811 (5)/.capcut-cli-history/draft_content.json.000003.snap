1,1]}}}}],\"text\":\"구조대 오는 거예요?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"c74852bd-59d3-4a99-a5c1-556f1f3344e6","type":"text","content":"{\"styles\":[{\"range\":[0,6],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"아니요\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"049b63ea-2656-4a69-a6b2-f4ba01d55f4f","type":"text","content":"{\"styles\":[{\"range\":[0,48],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"이제 구조대가 있는 옥상으로 올라가야 됩니다\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"d9803563-71ae-4204-a8f6-b3212a9115df","type":"text","content":"{\"styles\":[{\"range\":[0,28],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"- 아이... - 구조대는\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"3d7dc36a-ebe7-483d-8bc4-32b350257003","type":"text","content":"{\"styles\":[{\"range\":[0,30],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"감염자들과 충돌하면 안 돼요\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"6eb26bbc-3ee9-460c-85ed-b0dc08a16f0f","type":"text","content":"{\"styles\":[{\"range\":[0,40],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"아니, 여기 오는 것도 죽을 뻔했는데\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"0a86342e-23e2-4f1f-ae17-08ab28fad6ec","type":"text","content":"{\"styles\":[{\"range\":[0,26],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"공 교수도 준비해요, 어\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"186042c7-6308-4478-99d1-43265ae1121b","type":"text","content":"{\"styles\":[{\"range\":[0,2],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"네\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"470e136c-abb8-4273-807e-3e3502900422","type":"text","content":"{\"styles\":[{\"range\":[0,20],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"알파 팀은 정문으로\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"d4385388-181c-41e1-8a59-004392026583","type":"text","content":"{\"styles\":[{\"range\":[0,38],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"델타 팀은 우회해서 진입을 준비한다\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"b0fefb36-7337-4379-8581-b8a6da031cd0","type":"text","content":"{\"styles\":[{\"range\":[0,24],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"도망쳤는데 뭐요? 예?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"742d0e47-6888-406f-8783-4eeee634f89f","type":"text","content":"{\"styles\":[{\"range\":[0,10],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"아니, 뭐\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"4074fddf-4f51-44c0-9f4b-b6ec933f5826","type":"text","content":"{\"styles\":[{\"range\":[0,52],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"우리보다 저 새끼가 더 중요하다는 거야, 뭐야?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"c09a59ef-49db-4d11-b0a9-315e45579d87","type":"text","content":"{\"styles\":[{\"range\":[0,28],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"저 새끼가 백신이라고 했어\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"7b608a53-1031-43bc-94b2-9e64a17b217f","type":"text","content":"{\"styles\":[{\"range\":[0,12],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"방금 봤잖아\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"5dfcf50f-c519-4b2d-85a2-1a6f7964be48","type":"text","content":"{\"styles\":[{\"range\":[0,40],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"그 감염된 놈들이 건드리지도 않는 거\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"be080cc9-4fb0-4819-80ef-2f249da5ab2b","type":"text","content":"{\"styles\":[{\"range\":[0,36],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"저 백신을 데리고 나가야 된다고!\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"3b295b3d-4ed3-4b19-85f9-76d6e38925de","type":"text","content":"{\"styles\":[{\"range\":[0,48],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"아니, 저, 저 백신을 어떻게 데리고 나가?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"120e8304-7995-4b7e-b2e0-db89a112d9a9","type":"text","content":"{\"styles\":[{\"range\":[0,22],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"아이, 방금 봤잖아요\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"25f7883a-4c5d-44f8-8835-a5acd124f706","type":"text","content":"{\"styles\":[{\"range\":[0,40],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"그 괴물 같은 새끼들 득실득실대는 거\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"4466c683-4d06-46a6-98ae-5d4e453a4df1","type":"text","content":"{\"styles\":[{\"range\":[0,48],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"아, 근데 거기서 걔를 어떻게 꺼내 오냐고?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"3203cbc4-e8c5-49af-a9e8-4dcb31a7785f","type":"text","content":"{\"styles\":[{\"range\":[0,26],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"이제 어떡할 거야, 어?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"e4ce300e-808c-4916-86f7-ecadea5555ac","type":"text","content":"{\"styles\":[{\"range\":[0,18],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"- 현석아 - 어\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"58112acd-6ed4-4f19-bd81-161c74f054e5","type":"text","content":"{\"styles\":[{\"range\":[0,60],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"이 건물 전체 CCTV 볼 수 있는 통제실 어디 있어?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"c755ed5a-6aa7-4175-9243-fcf97ddc9808","type":"text","content":"{\"styles\":[{\"range\":[0,14],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"뭐? 통제실?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"624322ff-28e8-4228-9189-c239598a22c7","type":"text","content":"{\"styles\":[{\"range\":[0,48],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"넌 이 빌딩 보안 팀이니까 잘 알 거 아니야\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"82e091ab-94d8-4165-a3dc-f4c4db4a6f72","type":"text","content":"{\"styles\":[{\"range\":[0,18],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"- 어 - 우리가\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"c4d07d2e-054e-4119-b7e9-3b20515cde5e","type":"text","content":"{\"styles\":[{\"range\":[0,42],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"건물 전체 CCTV를 볼 수만 있으면은\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"a4a4a0df-fc4c-4dcb-b469-4734d182d1d2","type":"text","content":"{\"styles\":[{\"range\":[0,66],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"걔가 지금 실시간으로 어디로 이동하고 있는지 알 수가 있잖아\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"d16817ba-d873-4af2-8823-57a063146067","type":"text","content":"{\"styles\":[{\"range\":[0,38],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"이쪽으로 와 보셔야 할 것 같습니다\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"0beef85b-833b-4c09-b427-0500392b5376","type":"text","content":"{\"styles\":[{\"range\":[0,50],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"아니, 우리처럼 CCTV를 보고 있었던 거야?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"b577122b-683b-4e96-be6a-994a102f7408","type":"text","content":"{\"styles\":[{\"range\":[0,14],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"만약 서영철이\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"fe8a45f9-ed75-482d-b973-f9a85e0bdf03","type":"text","content":"{\"styles\":[{\"range\":[0,42],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"감염된 사람들을 통해 보고 있다면...\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"953ff0a0-5feb-4353-8304-f501753ca51c","type":"text","content":"{\"styles\":[{\"range\":[0,16],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"잠깐만, 그러면\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"93bd4120-b9d7-4e73-947e-f74ea4316878","type":"text","content":"{\"styles\":[{\"range\":[0,36],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"이 괴물 새끼들이 보고 있는 거를\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"8becb2b3-0349-41d8-90d1-4f333d365031","type":"text","content":"{\"styles\":[{\"range\":[0,42],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"서영철도 똑같이 볼 수 있다는 거예요?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"b467f63d-3a8c-4e85-be63-0a9bb527ddb4","type":"text","content":"{\"styles\":[{\"range\":[0,16],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"똑같이 본다고?\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"e8809887-ac94-4bb2-ab22-be261bdaba94","type":"text","content":"{\"styles\":[{\"range\":[0,24],\"size\":15,\"bold\":false,\"italic\":false,\"underline\":false,\"fill\":{\"alpha\":1,\"content\":{\"render_type\":\"solid\",\"solid\":{\"alpha\":1,\"color\":[1,1,1]}}}}],\"text\":\"아이, 그게 무슨...\"}","alignment":1,"font_size":15,"text_color":"#FFFFFF","typesetting":0,"letter_spacing":0,"line_spacing":0.02,"line_feed":1,"line_max_width":0.82,"force_apply_line_max_width":false,"check_flag":7,"fixed_width":-1,"fixed_height":-1},{"id":"6389e2f1-9978-45