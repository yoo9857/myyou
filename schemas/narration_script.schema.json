{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "items"],
  "properties": {
    "summary": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 140,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "use_narration", "role", "caption_ko", "tts_en", "delivery", "max_seconds", "handoff", "spoiler_risk", "rationale"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "use_narration": {"type": "boolean"},
          "role": {"type": "string", "enum": ["hook", "setup", "bridge", "escalation", "choice", "misdirection", "button"]},
          "caption_ko": {"type": "string"},
          "tts_en": {"type": "string"},
          "delivery": {"type": "string", "enum": ["intimate", "intrigued", "urgent", "somber", "neutral"]},
          "max_seconds": {"type": "number", "minimum": 2.0, "maximum": 5.2},
          "handoff": {"type": "string", "enum": ["next_dialogue", "visual_reveal", "silence"]},
          "spoiler_risk": {"type": "string", "enum": ["low", "medium", "high"]},
          "rationale": {"type": "string"}
        }
      }
    }
  }
}
